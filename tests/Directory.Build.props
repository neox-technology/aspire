<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsShipping>false</IsShipping>
    <IsPackable>false</IsPackable>
    <IsTestUtilityProject Condition="'$(IsUnitTestProject)' != 'true'">true</IsTestUtilityProject>
    <!-- Aspire 17 C# AppHosts require the CLI bundle (ASPIRE013). ASPIRE010 remains for non-C# hosts. -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <!-- ASPIRE012 / CS0618: harnesses keep Aspire.AppHost.Sdk and AddProject (ProjectResource). -->
    <NoWarn>$(NoWarn);ASPIRE010;ASPIRE012;CS0618</NoWarn>
  </PropertyGroup>
</Project>

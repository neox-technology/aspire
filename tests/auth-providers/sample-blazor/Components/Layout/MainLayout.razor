@inherits LayoutComponentBase

<div class="page">
    <header>
        <AuthorizeView>
            <Authorized>
                <span>@context.User.Identity?.Name</span>
                <a href="MicrosoftIdentity/Account/SignOut">Sign out</a>
            </Authorized>
            <NotAuthorized>
                <a href="MicrosoftIdentity/Account/SignIn">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>
    <main>
        <article>
            @Body
        </article>
    </main>
</div>

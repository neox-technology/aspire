@page "/"
@using Microsoft.Identity.Abstractions
@attribute [Authorize]
@inject IDownstreamApi DownstreamApi

<PageTitle>Auth sample Blazor</PageTitle>

<h1>AuthOps sample — Blazor Server</h1>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
else if (_me is null)
{
    <p>Loading user profile from API <code>/me</code>…</p>
}
else
{
    <p>Signed-in user (via API → Microsoft Graph):</p>
    <ul>
        <li><strong>Id</strong>: <code>@_me.Id</code></li>
        <li><strong>Display name</strong>: <code>@_me.DisplayName</code></li>
        <li><strong>Mail</strong>: <code>@_me.Mail</code></li>
        <li><strong>UPN</strong>: <code>@_me.UserPrincipalName</code></li>
    </ul>
}

@code {
    private MeDto? _me;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _me = await DownstreamApi.GetForUserAsync<MeDto>(
                "SampleApi",
                options => options.RelativePath = "me");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private sealed class MeDto
    {
        public string? Id { get; set; }
        public string? DisplayName { get; set; }
        public string? Mail { get; set; }
        public string? UserPrincipalName { get; set; }
    }
}

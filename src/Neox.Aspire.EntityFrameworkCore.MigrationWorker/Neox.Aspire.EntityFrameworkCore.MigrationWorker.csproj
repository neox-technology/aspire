<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Neox.Aspire.EntityFrameworkCore</RootNamespace>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <!-- Remain prerelease even when StabilizePackageVersion is true for the repo. -->
    <SuppressFinalPackageVersion>true</SuppressFinalPackageVersion>
    <Description>EF Core migration BackgroundService helpers for Aspire worker apps.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(MicrosoftEntityFrameworkCoreVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsHostingAbstractionsVersion)" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Neox.Aspire.Hosting.Keycloak</RootNamespace>
    <IsPackable>true</IsPackable>
    <SuppressFinalPackageVersion>true</SuppressFinalPackageVersion>
    <Description>Aspire hosting helpers for Keycloak-based authentication wiring.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aspire;keycloak;oidc;oauth2</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.Keycloak" Version="$(AspireHostingKeycloakVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Neox.Aspire.Hosting.Keycloak.Tests" />
  </ItemGroup>
</Project>

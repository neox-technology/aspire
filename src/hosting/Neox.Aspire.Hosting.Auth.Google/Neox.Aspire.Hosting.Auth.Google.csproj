<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Neox.Aspire.Hosting.Auth</RootNamespace>
    <IsPackable>true</IsPackable>
    <SuppressFinalPackageVersion>true</SuppressFinalPackageVersion>
    <Description>Aspire hosting AuthOps for Google: adopt/bind existing ClientId + ProjectId and AUTH_GOOGLE_* environment injection.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aspire;auth;google;oidc;iam;authops</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="$(AspireVersion)" />
    <PackageReference Include="Google.Apis.Auth" Version="1.69.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neox.Aspire.Hosting.Auth.Abstractions\Neox.Aspire.Hosting.Auth.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Neox.Aspire.Hosting.Auth.Tests" />
  </ItemGroup>
</Project>

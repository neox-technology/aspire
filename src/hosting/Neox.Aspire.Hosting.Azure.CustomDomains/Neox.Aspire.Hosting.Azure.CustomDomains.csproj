<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Neox.Aspire.Hosting.Azure</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
    <Description>Aspire hosting helpers for Azure Container Apps custom domains (OctoDNS-in-Docker, managed certificates).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aspire;azure;container-apps;dns;octodns;custom-domain</PackageTags>
    <UserSecretsId>f3c17a24-c048-442d-924f-143e22376191</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <AdditionalFiles Include="Provider\octodns-providers.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="$(AspireVersion)" />
    <PackageReference Include="Azure.Identity" Version="$(AzureIdentityVersion)" />
    <PackageReference Include="Azure.ResourceManager.AppContainers" Version="$(AzureResourceManagerAppContainersVersion)" />
    <PackageReference Include="YamlDotNet" Version="$(YamlDotNetVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neox.Aspire.Hosting.Azure.CustomDomains.Generators.Internal\Neox.Aspire.Hosting.Azure.CustomDomains.Generators.Internal.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Neox.Aspire.Hosting.Azure.CustomDomains.Tests" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Neox.Aspire.Hosting.Azure</RootNamespace>
    <IsPackable>true</IsPackable>
    <SuppressFinalPackageVersion>true</SuppressFinalPackageVersion>
    <Description>Aspire hosting helpers for Azure Container Apps custom domains (OctoDNS, managed certificates, GitHub Actions variables).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aspire;azure;container-apps;dns;octodns;custom-domain</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="$(AspireVersion)" />
  </ItemGroup>
</Project>

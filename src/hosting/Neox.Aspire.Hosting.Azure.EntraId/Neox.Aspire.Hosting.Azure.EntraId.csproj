<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Neox.Aspire.Hosting.Azure</RootNamespace>
    <IsPackable>true</IsPackable>
    <SuppressFinalPackageVersion>true</SuppressFinalPackageVersion>
    <Description>Aspire hosting helpers for Microsoft Entra ID app registrations (Azure.Provisioning Graph constructs).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aspire;azure;entra;oidc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure" Version="$(AspireVersion)" />
    <PackageReference Include="Azure.Identity" Version="$(AzureIdentityVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\provisioning\Neox.Azure.Provisioning.Graph\Neox.Azure.Provisioning.Graph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Neox.Aspire.Hosting.Azure.EntraId.Tests" />
    <InternalsVisibleTo Include="Neox.Aspire.Hosting.Keycloak.EntraId" />
  </ItemGroup>
</Project>

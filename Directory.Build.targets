<Project>
  <Import Project="Sdk.targets" Sdk="Microsoft.DotNet.Arcade.Sdk" />

  <!-- Override Arcade Microsoft defaults — must be AFTER Sdk.targets -->
  <PropertyGroup>
    <Company>Neox Technology</Company>
    <Authors>Neox Technology</Authors>
    <Copyright>© Neox Technology. All rights reserved.</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <!-- Lift transitive System.Security.Cryptography.Pkcs (8.0.1 / 9.0.11 / 10.0.10 / 10.0.11) to the patched 10.0.15. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>
</Project>

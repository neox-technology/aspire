<Project>
  <Import Project="Sdk.targets" Sdk="Microsoft.DotNet.Arcade.Sdk" />

  <!-- Override Arcade Microsoft defaults — must be AFTER Sdk.targets -->
  <PropertyGroup>
    <Company>Neox Technology</Company>
    <Authors>Neox Technology</Authors>
    <Copyright>© Neox Technology. All rights reserved.</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <!-- Transitive System.Security.Cryptography.Pkcs below 10.0.13 trips NU1902/NU1903.
       A direct reference unifies the graph. PrivateAssets keeps it out of shipping nuspecs.
       Lives in targets so IsRoslynComponent (set in the project body) is already defined. -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="$(SystemSecurityCryptographyPkcsVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>

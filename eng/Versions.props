<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
    <PreReleaseVersionLabel>preview</PreReleaseVersionLabel>
    <!-- Set to true for repo-wide GA (stable versions). Leave false while preview. -->
    <!-- Packages with SuppressFinalPackageVersion stay prerelease after stabilize. -->
    <StabilizePackageVersion>false</StabilizePackageVersion>
    <DotNetFinalVersionKind Condition="'$(StabilizePackageVersion)' == 'true'">release</DotNetFinalVersionKind>

    <!-- Align with Aspire 13.4.6 net10.0 dependency graph -->
    <AspireVersion>13.4.6</AspireVersion>
    <!-- Aspire.Hosting.Keycloak is preview-only on nuget.org (no stable 13.4.6) -->
    <AspireHostingKeycloakVersion>13.4.6-preview.1.26319.6</AspireHostingKeycloakVersion>
    <AspireKeycloakAuthenticationVersion>13.4.6-preview.1.26319.6</AspireKeycloakAuthenticationVersion>
    <MicrosoftEntityFrameworkCoreVersion>10.0.8</MicrosoftEntityFrameworkCoreVersion>
    <NpgsqlEntityFrameworkCorePostgreSQLVersion>10.0.0</NpgsqlEntityFrameworkCorePostgreSQLVersion>
    <MySqlEntityFrameworkCoreVersion>10.0.1</MySqlEntityFrameworkCoreVersion>
    <OracleEntityFrameworkCoreVersion>10.23.26300</OracleEntityFrameworkCoreVersion>
    <MicrosoftExtensionsHostingAbstractionsVersion>10.0.8</MicrosoftExtensionsHostingAbstractionsVersion>
    <!-- Arcade property (XUnitVersion); pins xunit.core / assert / runners -->
    <XUnitVersion>2.9.3</XUnitVersion>
    <AzureProvisioningVersion>1.5.0</AzureProvisioningVersion>
    <MicrosoftIdentityWebVersion>4.13.2</MicrosoftIdentityWebVersion>
    <SwashbuckleAspNetCoreVersion>10.2.3</SwashbuckleAspNetCoreVersion>
  </PropertyGroup>
</Project>
